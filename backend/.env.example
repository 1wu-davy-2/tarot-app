# ============================================================
# 命运之镜 · Mirror of Fate — Backend 环境配置
# 复制此文件为 .env 并修改对应值
# ============================================================

# ── 数据库 (MariaDB/MySQL) ──
# 如果设置了 database_url，会覆盖下面的 db_* 字段
# database_url=
db_host=localhost
db_port=3306
db_user=root
db_password=
db_name=tarot

# SQLite 模式（开发用，免装 MariaDB）：
# database_url=sqlite:///./tarot.db

# ── Redis ──
# 如果设置了 redis_url，会覆盖下面的 redis_* 字段
# redis_url=
redis_host=localhost
redis_port=6379
redis_password=
redis_db=0

# ── JWT ──
jwt_secret=change-this-to-a-random-string
jwt_algorithm=HS256
jwt_expire_minutes=1440

# ── 邮件 ──
# console: 验证码打印到终端（开发用）
# smtp:    通过 SMTP 发送真实邮件
email_mode=console
smtp_host=
smtp_port=587
smtp_user=
smtp_password=
smtp_from=noreply@tarot-app.com
smtp_from_name=命运之镜 - Mirror of Fate

# ── 配额 ──
daily_base_quota=2
checkin_min_bonus=2
checkin_max_bonus=8
admin_quota=999

# ── DeepSeek AI ──
deepseek_api_key=

# ── CORS ──
cors_origins=http://localhost:3000
